root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.sh]
# shfmt
switch_case_indent = true

# A recipe is indented with a tab, and its continuation lines with a tab and the spaces that align them; a Markdown
# file carries such recipes in its examples; the LICENSE is the text as published.
[{Makefile,*.mk,*.md,LICENSE}]
indent_style = unset
indent_size = unset
