{
  "lock": {
    "frozen": true
  },
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.2.5/",
    "@std/http": "jsr:@std/http@1.1.0",
    "playwright": "npm:playwright@1.64.1",
    "@axe-core/playwright": "npm:@axe-core/playwright@4.14.0",
    "stylelint-config-standard": "npm:stylelint-config-standard@40.0.0"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "html": "deno run --allow-read --allow-env --allow-sys npm:html-validate@11.16.1 '_site/**/*.html'",
    "md": "deno run --allow-read --allow-env --allow-sys npm:markdownlint-cli2@0.24.0",
    "css": "deno run --allow-read --allow-env --allow-sys npm:stylelint@17.16.0 'styles.css'",
    "seo": "deno run --allow-read --allow-net=cdn.jsdelivr.net _seo.ts",
    "browser": "deno run -A npm:playwright@1.64.1 install chromium-headless-shell",
    "a11y": "deno run -A _a11y.ts",
    "content": "deno test --allow-read --allow-write _content_test.ts"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ]
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": [
      "_site/",
      "node_modules/"
    ]
  },
  "lint": {
    "exclude": [
      "_site/",
      "node_modules/"
    ]
  },
  "nodeModulesDir": "auto"
}
